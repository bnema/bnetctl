# Maintainer: bnema <b at bnema dot dev>
# The release workflow updates pkgver before publishing to the AUR.
pkgname=bnetctl-git
pkgver=1.0.0
pkgrel=1
pkgdesc='CLI to install, manage, and run Battle.net on Linux via Wine (git version)'
arch=('x86_64' 'aarch64')
url='https://git.bnema.dev/bnetctl'
license=('MIT')
makedepends=('go' 'git')
provides=('bnetctl' 'bnetctl-bin')
conflicts=('bnetctl' 'bnetctl-bin')
source=('git+https://git.bnema.dev/bnetctl.git')
sha256sums=('SKIP')

pkgver() {
	cd bnetctl
	git describe --long --tags --abbrev=7 --exclude='*-*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd bnetctl
	export CGO_ENABLED=0
	go build -trimpath -ldflags "-X github.com/bnema/bnetctl/cmd.version=$pkgver" -o bnetctl .
}

check() {
	cd bnetctl
	./bnetctl --version
}

package() {
	cd bnetctl
	install -Dm755 bnetctl "$pkgdir/usr/bin/bnetctl"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
